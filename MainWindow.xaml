<Window x:Class="Geometrie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Je révise la géométrie !" Height="790" Width="1220"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF8FF" Offset="0"/>
            <GradientStop Color="#F5EEFF" Offset="0.55"/>
            <GradientStop Color="#FFF8D7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.16"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#203040"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#203040"/>
            <Setter Property="Padding" Value="0,6,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#B9DCEB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#75BBD4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CFE8F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#24566A"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ShapeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="BorderBrush" Value="#B9DCEB"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="SmallInfo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button x:Name="MiniJeuSecretButton" Content="?"
                    DockPanel.Dock="Right"
                    Width="34" MinHeight="34" Padding="0"
                    Margin="12,2,0,0"
                    Background="#FFFFFFCC" BorderBrush="#CDB7FF"
                    Opacity="0.7"
                    ToolTip="Mini surprise"
                    Click="MiniJeuSecretButton_Click"/>
            <TextBlock Text="Je révise la géométrie !"
                       FontSize="36" FontWeight="Bold" Foreground="#1F6F8B"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Mon exercice" Style="{StaticResource SectionTitle}"/>

                        <ComboBox x:Name="FormeComboBox" Visibility="Collapsed"
                                  SelectionChanged="FormeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Carré"/>
                            <ComboBoxItem Content="Rectangle"/>
                            <ComboBoxItem Content="Cercle"/>
                            <ComboBoxItem Content="Triangle"/>
                            <ComboBoxItem Content="Ellipse"/>
                        </ComboBox>

                        <Label Content="Je choisis une forme"/>
                        <UniformGrid Columns="2" Margin="0,2,0,12">
                            <Button x:Name="CarreButton" Tag="Carré" Content="◼ Carré"
                                    Style="{StaticResource ShapeButton}" Click="FormeButton_Click"/>
                            <Button x:Name="RectangleButton" Tag="Rectangle" Content="▭ Rectangle"
                                    Style="{StaticResource ShapeButton}" Click="FormeButton_Click"/>
                            <Button x:Name="CercleButton" Tag="Cercle" Content="⚪ Cercle"
                                    Style="{StaticResource ShapeButton}" Click="FormeButton_Click"/>
                            <Button x:Name="TriangleButton" Tag="Triangle" Content="🔺 Triangle"
                                    Style="{StaticResource ShapeButton}" Click="FormeButton_Click"/>
                            <Button x:Name="EllipseButton" Tag="Ellipse" Content="🥚 Ellipse"
                                    Style="{StaticResource ShapeButton}" Click="FormeButton_Click"/>
                        </UniformGrid>

                        <TextBlock Text="Dimensions" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>

                        <StackPanel x:Name="CarrePanel" Visibility="Collapsed">
                            <Label Content="Côté"/>
                            <TextBox x:Name="CoteTextBox"/>
                        </StackPanel>

                        <StackPanel x:Name="RectanglePanel" Visibility="Collapsed">
                            <Label Content="Longueur"/>
                            <TextBox x:Name="LongueurTextBox"/>
                            <Label Content="Largeur"/>
                            <TextBox x:Name="LargeurTextBox"/>
                        </StackPanel>

                        <StackPanel x:Name="CerclePanel" Visibility="Collapsed">
                            <Label Content="Rayon"/>
                            <TextBox x:Name="RayonTextBox"/>
                        </StackPanel>

                        <StackPanel x:Name="TrianglePanel" Visibility="Collapsed">
                            <Label Content="Base"/>
                            <TextBox x:Name="BaseTextBox"/>
                            <Label Content="Côté 1"/>
                            <TextBox x:Name="C1TextBox"/>
                            <Label Content="Côté 2"/>
                            <TextBox x:Name="C2TextBox"/>
                            <Label Content="Hauteur"/>
                            <TextBox x:Name="HauteurTextBox"/>
                        </StackPanel>

                        <StackPanel x:Name="EllipsePanel" Visibility="Collapsed">
                            <Label Content="Grand rayon"/>
                            <TextBox x:Name="GrandRayonTextBox"/>
                            <Label Content="Petit rayon"/>
                            <TextBox x:Name="PetitRayonTextBox"/>
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,6">
                            <Button x:Name="GenererButton" Content="Générer"
                                    Background="#BDE7F6" Click="GenererButton_Click"/>
                            <Button x:Name="DefiRapideButton" Content="Défi rapide"
                                    Background="#D9CCFF" Click="DefiRapideButton_Click"/>
                            <Button x:Name="ModeAventureButton" Content="🗺️ Mode Aventure"
                                    Background="#CFF0D8" BorderBrush="#79C98A"
                                    Click="ModeAventureButton_Click"/>
                            <Button x:Name="ReinitialiserButton" Content="Réinitialiser"
                                    Background="#FFE0A6" Click="ReinitialiserButton_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Mes réponses" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>

                        <Label Content="Périmètre"/>
                        <TextBox x:Name="PerimetreTextBox"/>

                        <Label Content="Surface"/>
                        <TextBox x:Name="SurfaceTextBox"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ValiderButton" Content="Valider mes réponses"
                                    Background="#BFE8C7" BorderBrush="#79C98A"
                                    Click="ValiderButton_Click"/>
                            <Button x:Name="FormuleButton" Content="💡 Formule"
                                    Background="#FFF1A8" BorderBrush="#E3BD45"
                                    Click="FormuleButton_Click"/>
                            <Button x:Name="QuitterButton" Content="Quitter"
                                    Background="#F4B8B8" BorderBrush="#E08A8A"
                                    Click="QuitterButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Dessin de la forme" Style="{StaticResource SectionTitle}"/>
                        <Border Grid.Row="1" CornerRadius="18" BorderBrush="#BFE5F3"
                                BorderThickness="2" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F2FBFF" Offset="0"/>
                                    <GradientStop Color="#FFF9E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Canvas x:Name="FormeCanvas" Background="Transparent"
                                    MinHeight="390" ClipToBounds="True"/>
                        </Border>
                        <TextBlock x:Name="DimensionsTextBlock" Grid.Row="2"
                                   FontSize="17" TextWrapping="Wrap"
                                   Margin="0,14,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="ResultatBorder" Grid.Row="1" Background="#FFF7D6"
                        BorderBrush="#F3D36B" BorderThickness="2"
                        CornerRadius="18" Padding="18" Margin="0,18,0,0"
                        Effect="{StaticResource SoftShadow}">
                    <TextBlock x:Name="ResultatTextBlock"
                               Text="Choisis une forme, puis génère un exercice ou entre tes dimensions."
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ma progression" Style="{StaticResource SectionTitle}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Border Background="#FFF6CB" CornerRadius="14" Padding="10" Margin="0,0,8,8">
                                <TextBlock x:Name="ScoreTextBlock" Text="⭐ Score : 0" FontSize="16" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#EDE4FF" CornerRadius="14" Padding="10" Margin="0,0,0,8">
                                <TextBlock x:Name="NiveauTextBlock" Text="🧠 Niveau : 1" FontSize="16" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#FFE7D7" CornerRadius="14" Padding="10" Margin="0,0,8,8">
                                <TextBlock x:Name="SerieTextBlock" Text="🔥 Série : 0" FontSize="16" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#E3F7E9" CornerRadius="14" Padding="10" Margin="0,0,0,8">
                                <TextBlock x:Name="RecordTextBlock" Text="🏆 Record : 0" FontSize="16" FontWeight="Bold"/>
                            </Border>
                        </UniformGrid>

                        <TextBlock x:Name="XpTextBlock" Text="XP : 0 / 100"
                                   Style="{StaticResource SmallInfo}" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="XpProgressBar" Minimum="0" Maximum="100" Height="20"
                                     Margin="0,0,0,14" Foreground="#6FCF97"/>

                        <TextBlock Text="Mes badges" Style="{StaticResource SectionTitle}" Margin="0,4,0,10"/>
                        <WrapPanel x:Name="BadgesWrapPanel" Margin="0,0,0,14"/>

                        <Button x:Name="ResetProgressionButton" Content="Réinitialiser la progression"
                                Background="#F7CACA" BorderBrush="#E08A8A"
                                Click="ResetProgressionButton_Click"/>

                        <Border Background="#F3FAFF" BorderBrush="#BFE5F3" BorderThickness="2"
                                CornerRadius="18" Padding="14" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🤖" FontSize="34" HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Géo le robot dit :" FontSize="19"
                                               FontWeight="Bold" Foreground="#1F6F8B"
                                               Margin="0,0,0,6"/>
                                    <Border Background="#FFFFFF" BorderBrush="#D8EEF7"
                                            BorderThickness="1" CornerRadius="14" Padding="10">
                                        <TextBlock x:Name="MascotteTextBlock"
                                                   Text="Le périmètre, c'est le tour de la figure !"
                                                   FontSize="16" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
