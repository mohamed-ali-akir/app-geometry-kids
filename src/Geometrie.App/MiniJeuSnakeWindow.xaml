<Window x:Class="Geometrie.MiniJeuSnakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini surprise" Height="540" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2FBFF" Offset="0"/>
            <GradientStop Color="#FFF4C8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#203040"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#75BBD4"/>
            <Setter Property="Background" Value="#E7F6FF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mini Snake secret"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1F6F8B"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,8,0,12" HorizontalAlignment="Center">
            <TextBlock x:Name="ScoreTextBlock"
                       Text="Score : 0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextAlignment="Center"/>
            <TextBlock x:Name="MessageTextBlock"
                       Text="Utilise les flèches pour attraper les pommes."
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Width="364"
                Height="364"
                Padding="2"
                Background="#FFFFFF"
                BorderBrush="#BFE5F3"
                BorderThickness="2"
                CornerRadius="16"
                HorizontalAlignment="Center">
            <Canvas x:Name="JeuCanvas"
                    Width="360"
                    Height="360"
                    Background="#F1FBF0"
                    ClipToBounds="True"
                    Focusable="True"/>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button x:Name="RejouerButton"
                    Content="Rejouer"
                    Background="#BFE8C7"
                    BorderBrush="#79C98A"
                    Click="RejouerButton_Click"/>
            <Button x:Name="QuitterMiniJeuButton"
                    Content="Quitter"
                    Background="#F4B8B8"
                    BorderBrush="#E08A8A"
                    Click="QuitterMiniJeuButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
